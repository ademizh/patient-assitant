# Скопируйте в .env и заполните. Никогда не публикуйте свой настоящий .env.

# --- Режим -----------------------------------------------------------------------------
# auto = рабочий режим, если задан OPENAI_API_KEY, иначе демо (офлайн-эвристики)
# demo = всегда офлайн-демо (данные не покидают компьютер)
# live = требовать ключ API
APP_MODE=auto

# --- OpenAI ----------------------------------------------------------------------------
OPENAI_API_KEY=
# Необязательно: OpenAI-совместимый адрес. Для api.openai.com оставьте закомментированным.
# OPENAI_BASE_URL=https://your-endpoint/v1

# Названия моделей настраиваются. Значения по умолчанию — по документации OpenAI на октябрь 2026;
# см. https://developers.openai.com/api/docs/models и замените, если у аккаунта нет доступа.
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Язык речи для расшифровки (ISO-639-1). Пусто = автоопределение.
TRANSCRIPTION_LANGUAGE=ru

# --- Записи о приёме (данные пациента, хранятся локально, отдельно от базы знаний) --------
APPOINTMENTS_PATH=data/appointments
# Правила срочности. Встроенный файл — ДЕМОНСТРАЦИОННЫЙ (не проверен клиницистом).
URGENT_RULES_PATH=data/pathways/DEMO_urgent_rules_ru.json

# --- Поиск по документам (только медицинские справочные документы) -----------------------
CHROMA_PATH=data/chroma
LIBRARY_PATH=data/library_files
CHROMA_COLLECTION_PREFIX=medical_docs
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
# Порог косинусного сходства. Пусто = значение режима по умолчанию (рабочий 0.30, демо 0.12).
MIN_RELEVANCE=

# --- Аудио -----------------------------------------------------------------------------
MAX_AUDIO_MB=25
